# ────────────────────────────────────────────────────────────────────────────
# StoryFrame Studio – Environment Configuration
# Copy this file to .env and fill in your API keys.
# ────────────────────────────────────────────────────────────────────────────

# ── TTS Providers ────────────────────────────────────────────────────────────
# Options: elevenlabs | deepgram
TTS_PROVIDER=elevenlabs

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

DEEPGRAM_API_KEY=
DEEPGRAM_VOICE_MODEL=aura-asteria-en

# Seconds of silence to prepend before narration starts (0 = disabled)
TTS_LEADING_SILENCE_SECONDS=0.0
# Seconds of silence to append after narration ends (0 = disabled)
TTS_TRAILING_SILENCE_SECONDS=0.0

# ── Image Provider ────────────────────────────────────────────────────────────
# Currently supported: replicate
IMAGE_PROVIDER=replicate

REPLICATE_API_TOKEN=
# Example model: stability-ai/sdxl:39ed52f2319f9b...
REPLICATE_MODEL=

# ── Video Provider (future) ───────────────────────────────────────────────────
# Options: none | (future: runway | pika)
VIDEO_PROVIDER=none
VIDEO_PROVIDER_API_KEY=

# ── Rendering ─────────────────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Auto-detect NVIDIA NVENC GPU encoder; falls back to libx264 if unavailable
USE_NVENC_AUTO=true
DEFAULT_FPS=30
DEFAULT_RESOLUTION=1920x1080
# Duration each image is shown in the video (seconds)
IMAGE_DURATION_SECONDS=8
# Ken Burns zoom/pan or static
ZOOM_STYLE=ken_burns
CROSSFADE_DURATION=1.0

# ── Output Paths ──────────────────────────────────────────────────────────────
OUTPUT_DIR=projects/output
TEMP_DIR=projects/temp
